{
  "name": "idea",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:admin": "vite build --config admin/vite.config.js",
    "build:all": "npm run build && npm run build:admin",
    "lint": "eslint .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:two-account": "node scripts/verify-two-account-messaging.mjs",
    "test:production-realtime": "node scripts/verify-goal-a-production-realtime.mjs",
    "test:cursor-realtime": "node scripts/verify-goal-a-cursor-realtime.mjs",
    "test:rls": "node scripts/verify-goal-a-rls.mjs",
    "prepare:rls-fixture": "node scripts/prepare-goal-a-rls-fixture.mjs",
    "check": "npm run lint && npm run test:run && npm run build:all",
    "preview": "vite preview"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/supabase-js": "^2.106.2",
    "lucide-react": "^1.17.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-easy-crop": "^6.0.2",
    "react-router-dom": "^7.15.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^30.0.1",
    "vite": "^8.0.12",
    "vitest": "^5.0.0"
  }
}
